# Environnement DEVELOPMENT deploye (docker-compose.development.yml).
# Ce fichier ne contient AUCUNE vraie valeur. Sur le serveur de dev, ces
# variables sont fournies via GitHub Secrets (voir docs/deployment.md,
# section "Secrets") et materialisees en .env.development au moment du
# deploiement par le workflow CD - ce fichier ne doit jamais etre commite
# avec de vraies valeurs.
#
# Base/utilisateur dedies a cet environnement, distincts du local et de la
# production, pour qu'il soit impossible de pointer par erreur sur une
# autre base.

# --- PostgreSQL (development) ---
POSTGRES_USER=hadoum_development_user
POSTGRES_PASSWORD=change_me_development_password
POSTGRES_DB=hadoum_development_db

# --- JWT ---
JWT_SECRET=change_me_development_jwt_secret_min_32_chars

# --- Stockage S3 (Hetzner Object Storage) ---
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=eu-central
S3_ACCESS_KEY=your_development_access_key
S3_SECRET_KEY=your_development_secret_key
S3_BUCKET=hadoum-development

# --- SMTP ---
SMTP_USER=your_development_smtp_user
SMTP_PASS=your_development_smtp_password

# --- Divers ---
FRONTEND_URL=https://dev.hadoum.com
NGINX_SERVER_NAME=dev.hadoum.com
NGINX_CERT_DOMAIN=dev.hadoum.com
HTTP_PORT=8080
HTTPS_PORT=8443
TLS_CERT_PATH=/etc/letsencrypt
API_IMAGE=hadoum-api
FRONTEND_IMAGE=hadoum-frontend
IMAGE_TAG=latest
LOG_LEVEL=info
RATE_LIMIT_MAX=200
RATE_LIMIT_TTL_MS=60000

# --- Alerting (optionnel) ---
# Webhook Slack/Discord-compatible pour les alertes automatiques
# (echec de backup, migration, healthcheck...). Laisser vide pour desactiver.
ALERT_WEBHOOK_URL=
