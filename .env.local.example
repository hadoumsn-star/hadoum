# Environnement LOCAL uniquement (docker-compose.local.yml).
# Ce fichier ne contient AUCUNE vraie valeur. Copiez-le en .env.local puis
# remplacez les placeholders. .env.local ne doit jamais etre commite.
#
# Ces valeurs sont volontairement DIFFERENTES de la production et de
# l'environnement "development" deploye (utilisateur/base dedies au poste
# local) pour qu'il soit impossible de pointer par erreur vers une autre
# base depuis cet environnement.

# --- PostgreSQL (local) ---
POSTGRES_USER=hadoum_dev_user
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=hadoum_dev_db

# URL utilisee PAR LE CONTENEUR API (reseau interne Compose, host = "postgres").
# Pour lancer Prisma depuis votre machine hote (hors conteneur), voir
# docs/LOCAL_ENVIRONMENT.md - ne remplacez pas "postgres" par "localhost" ici.
DATABASE_URL=postgresql://hadoum_dev_user:change_me_dev_password@postgres:5432/hadoum_dev_db

# --- JWT ---
JWT_SECRET=change_me_dev_jwt_secret_min_32_chars

# --- Stockage S3 (Hetzner Object Storage) - optionnel en local ---
# Par defaut vide : les uploads (documents/photos de rapport) echouent en
# local tant que ces variables ne sont pas remplies, ce qui est accepte
# (voir docs/testing.md). Deux options pour les remplir :
#   1) Hetzner reel (memes valeurs qu'en dev/prod, avec un bucket dedie) :
#        S3_ENDPOINT=https://hel1.your-objectstorage.com
#        S3_REGION=eu-central
#        S3_ACCESS_KEY=your_dev_access_key
#        S3_SECRET_KEY=your_dev_secret_key
#        S3_BUCKET=hadoum-dev
#   2) MinIO local (PR 19) - le service "minio" de docker-compose.local.yml,
#      pour de vrais tests d'upload/PDF sans toucher a Hetzner :
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=hadoum_dev_minio
S3_SECRET_KEY=change_me_dev_minio_password
S3_BUCKET=hadoum-local
MINIO_ROOT_USER=hadoum_dev_minio
MINIO_ROOT_PASSWORD=change_me_dev_minio_password

# --- SMTP - optionnel en local ---
SMTP_USER=your_dev_smtp_user
SMTP_PASS=your_dev_smtp_password

# --- Divers ---
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api
PORT=3001
APP_ENV=local
LOG_LEVEL=debug
RATE_LIMIT_MAX=1000
RATE_LIMIT_TTL_MS=60000
