generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ChildStatus {
  ORPHELIN_COMPLET
  ORPHELIN_PERE
  ORPHELIN_MERE
  DEMI_ORPHELIN
  ENFANT_EN_DIFFICULTE
}

enum Gender {
  MASCULIN
  FEMININ
}

enum SchoolType {
  DAARA
  ECOLE_PUBLIQUE
  ECOLE_PRIVEE
}

enum DocumentType {
  ACTE_NAISSANCE
  ACTE_DECES
  PIECE_ID_TUTEUR
  ACCORD_AEMO
  CARNET_SANTE
  CERTIFICAT_PEC
  AUTORISATION_GOUVERNEMENTALE
  PHOTO
  ORDONNANCE
  BULLETIN_SCOLAIRE
  LEGAL_DOCUMENT
  EVALUATION_PSYCHOMOTRICE
  BILAN_PSYCHOLOGIQUE
  BILAN_SANTE
  AUTRE
}

// ─── Core entity ─────────────────────────────────────────────────────────────

model Child {
  id           String      @id @default(uuid())
  fileNumber   String      @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  placeOfBirth String
  gender       Gender
  entryDate    DateTime
  status       ChildStatus

  // Legal guardian
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?

  // Emergency contacts (stored as JSON for flexibility)
  emergencyContacts Json?

  // Family situation
  familyComposition String?
  placementHistory  String?
  familyContacts    Json?

  // Exit / departure
  isActive        Boolean   @default(true)
  exitType        String? // 'temporaire' | 'définitive'
  exitDate        DateTime?
  exitReturnDate  DateTime?
  exitReason      String?
  exitResponsable String?

  // Relations
  medicalRecord     MedicalRecord?
  psychRecord       PsychRecord?
  schoolRecord      SchoolRecord?
  dailyObservations DailyObservation[]
  documents         Document[]
  eventLogs         EventLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Medical ─────────────────────────────────────────────────────────────────

model MedicalRecord {
  id      String @id @default(uuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  bloodType         String?
  allergies         String?
  currentTreatments String?
  vaccinationsText  String?
  consultationsText String?

  vaccinations  Vaccination[]
  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vaccination {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  name        String
  date        DateTime
  nextDueDate DateTime?
  notes       String?
}

model Consultation {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  date         DateTime
  doctor       String
  reason       String
  prescription String?
  documentUrl  String?

  createdAt DateTime @default(now())
}

// ─── Psychological ───────────────────────────────────────────────────────────

model PsychRecord {
  id      String @id @default(uuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  initialAssessment   String?
  pppObjectives       String?
  behavioralEvolution String?

  sessions PsychSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PsychSession {
  id            String      @id @default(uuid())
  psychRecordId String
  psychRecord   PsychRecord @relation(fields: [psychRecordId], references: [id], onDelete: Cascade)

  date         DateTime
  observations String
  progress     String?

  createdAt DateTime @default(now())
}

// ─── School ──────────────────────────────────────────────────────────────────

model SchoolRecord {
  id      String @id @default(uuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  schoolType   SchoolType
  schoolName   String
  currentLevel String

  results SchoolResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolResult {
  id             String       @id @default(uuid())
  schoolRecordId String
  schoolRecord   SchoolRecord @relation(fields: [schoolRecordId], references: [id], onDelete: Cascade)

  period       String
  subject      String
  grade        Float?
  attendance   String?
  teacherNotes String?
  bulletinUrl  String?

  createdAt DateTime @default(now())
}

// ─── Daily observations ──────────────────────────────────────────────────────

model DailyObservation {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  date             DateTime
  author           String
  behavior         String
  groupIntegration String?
  incidents        String?
  notes            String?

  createdAt DateTime @default(now())
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  type       DocumentType
  label      String
  fileUrl    String
  uploadedBy String?

  createdAt DateTime @default(now())
}

// ─── Event log (journal) ─────────────────────────────────────────────────────

model EventLog {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  eventType String
  summary   String
  details   String?
  author    String?

  createdAt DateTime @default(now())
}

// ─── Staff ───────────────────────────────────────────────────────────────────

enum StaffStatus {
  PRESENT
  ABSENT
  CONGE
}

enum CandidateStatus {
  NOUVEAU
  PRESELECTIONNE
  ENTRETIEN_FAIT
}

model StaffMember {
  id           String      @id @default(uuid())
  firstName    String
  lastName     String
  role         String
  classes      String[]
  status       StaffStatus @default(PRESENT)
  phone        String?
  email        String?
  since        DateTime    @default(now())
  cvKey        String?
  scheduleKey  String?
  scheduleJson String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Candidate {
  id                       String          @id @default(uuid())
  firstName                String
  lastName                 String
  targetRole               String?
  phone                    String?
  status                   CandidateStatus @default(NOUVEAU)
  cvKey                    String?
  typeCandidature          String?
  disponibleDe             DateTime?
  contactInfo              String?
  notes                    String?
  scheduledIntegrationDate DateTime?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormerStaffMember {
  id                         String    @id @default(uuid())
  firstName                  String
  lastName                   String
  role                       String
  exitDate                   DateTime
  exitReason                 String
  scheduledReintegrationDate DateTime?
  scheduledRole              String?

  createdAt DateTime @default(now())
}

model CandidateDoc {
  id          String   @id @default(uuid())
  candidateId String
  key         String
  label       String
  createdAt   DateTime @default(now())
}

model StaffDoc {
  id        String   @id @default(uuid())
  staffId   String
  key       String
  label     String
  createdAt DateTime @default(now())
}

model StaffAttendance {
  id        String    @id @default(uuid())
  staffId   String
  type      String
  motif     String?
  dateDebut DateTime
  dateFin   DateTime?
  justifKey String?
  justified Boolean   @default(false)

  createdAt DateTime @default(now())
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id         String   @id @default(uuid())
  title      String
  type       String
  fileKey    String
  mimeType   String
  reportDate DateTime
  uploadedBy String?

  createdAt DateTime @default(now())
}

// ─── Finances ─────────────────────────────────────────────────────────────────

enum TransactionType {
  DEPENSE
  RECETTE
}

enum TransactionCategory {
  ALIMENTATION
  SALAIRES
  ENTRETIEN
  SANTE
  PEDAGOGIE
  EQUIPEMENT
  DON
  VIREMENT
  APPORT
  AUTRE
}

enum TransactionStatus {
  VALIDE
  EN_ATTENTE
}

model Transaction {
  id        String              @id @default(uuid())
  type      TransactionType
  category  TransactionCategory
  label     String
  amountXof Int
  date      DateTime
  status    TransactionStatus   @default(EN_ATTENTE)

  justifKey  String?
  justifMime String?

  donorName        String?
  isAnonymousDonor Boolean?

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetLine {
  id        String              @id @default(uuid())
  category  TransactionCategory
  month     Int
  year      Int
  budgetXof Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, month, year])
}

// ─── Incidents ────────────────────────────────────────────────────────────────

enum IncidentType {
  MEDICAL
  COMPORTEMENT
  SCOLAIRE
  LOGISTIQUE
  AUTRE
}

enum IncidentStatus {
  EN_COURS
  PLANIFIE
  EN_RETARD
  RESOLU
}

model Incident {
  id          String         @id @default(uuid())
  title       String
  type        IncidentType
  description String?
  signaledBy  String
  date        DateTime       @default(now())
  status      IncidentStatus @default(EN_COURS)

  attachmentKey  String?
  attachmentMime String?

  notes          IncidentNote[]
  entryLogs      EntryLog[]
  goodsMovements GoodsMovementLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IncidentNote {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  text   String
  author String

  createdAt DateTime @default(now())
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

enum UserRole {
  DIRECTOR
  EDUCATOR
  SUPERVISOR
  BOARD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  initials     String
  role         UserRole
  roleLabel    String
  title        String

  resetToken       String?
  resetTokenExpiry DateTime?

  validationRequestsSubmitted ValidationRequest[] @relation("ValidationSubmittedBy")
  validationRequestsReviewed  ValidationRequest[] @relation("ValidationReviewedBy")
  notifications               Notification[]

  administrativeProceduresCreated AdministrativeProcedure[] @relation("ProcedureCreatedBy")
  procedureDocumentsUploaded      ProcedureDocument[]       @relation("ProcedureDocumentUploadedBy")

  stockItemsCreated          StockItem[]              @relation("StockItemCreatedBy")
  stockMovementsPerformed    StockMovement[]          @relation("StockMovementPerformedBy")
  stockMovementsApproved     StockMovement[]          @relation("StockMovementApprovedBy")
  stockItemDocumentsUploaded StockItemDocument[]      @relation("StockItemDocumentUploadedBy")
  inventoryAssetsCreated     InventoryAsset[]         @relation("InventoryAssetCreatedBy")
  inventoryAssetsAssigned    InventoryAsset[]         @relation("AssetAssignedTo")
  assetDocumentsUploaded     InventoryAssetDocument[] @relation("AssetDocumentUploadedBy")

  entryLogsRecorded              EntryLog[]              @relation("EntryLogRecordedBy")
  entryLogsAuthorized            EntryLog[]              @relation("EntryLogAuthorizedBy")
  entryLogsVisited               EntryLog[]              @relation("EntryLogPersonVisited")
  entryLogDocumentsUploaded      EntryLogDocument[]      @relation("EntryLogDocumentUploadedBy")
  goodsMovementsRecorded         GoodsMovementLog[]      @relation("GoodsMovementRecordedBy")
  goodsMovementsAuthorized       GoodsMovementLog[]      @relation("GoodsMovementAuthorizedBy")
  goodsMovementDocumentsUploaded GoodsMovementDocument[] @relation("GoodsMovementDocumentUploadedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Administration : Locaux et espaces ──────────────────────────────────────

enum SpaceType {
  SALLE_CLASSE
  DORTOIR
  CUISINE
  SANITAIRE
  BUREAU
  INFIRMERIE
  STOCKAGE
  ESPACE_EXTERIEUR
  AUTRE
}

enum SpaceCondition {
  BON
  MOYEN
  MAUVAIS
  HORS_SERVICE
}

model Space {
  id           String         @id @default(uuid())
  name         String
  type         SpaceType
  description  String?
  building     String?
  floor        String?
  zone         String?
  condition    SpaceCondition @default(BON)
  capacity     Int?
  equipment    String[]
  observations String?
  isActive     Boolean        @default(true)

  documents          SpaceDocument[]
  maintenanceTickets MaintenanceTicket[]
  stockItems         StockItem[]
  inventoryAssets    InventoryAsset[]
  entryLogs          EntryLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpaceDocument {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  fileKey  String
  fileMime String
  label    String?

  createdAt DateTime @default(now())
}

// ─── Administration : Tickets de maintenance ─────────────────────────────────

enum TicketUrgency {
  FAIBLE
  MOYENNE
  ELEVEE
  CRITIQUE
}

enum TicketStatus {
  OUVERT
  ASSIGNE
  EN_COURS
  EN_ATTENTE
  RESOLU
  FERME
  ANNULE
}

model MaintenanceTicket {
  id          String  @id @default(uuid())
  title       String
  description String?
  problemType String?

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  urgency TicketUrgency
  status  TicketStatus  @default(OUVERT)

  reportedDate DateTime @default(now())
  reportedBy   String
  assignedTo   String?

  plannedDate     DateTime?
  resolvedDate    DateTime?
  resolutionNotes String?

  estimatedCost Int?
  actualCost    Int?

  validationStatus ValidationStatus?

  attachments TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([status])
}

model TicketAttachment {
  id       String            @id @default(uuid())
  ticketId String
  ticket   MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  fileKey  String
  fileMime String

  createdAt DateTime @default(now())
}

// ─── Administration : Validations ────────────────────────────────────────────

enum ValidationStatus {
  DRAFT
  PENDING_VALIDATION
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ValidationResourceType {
  MAINTENANCE_TICKET
  SUPPLIER_CONTRACT
  ADMINISTRATIVE_PROCEDURE
  STOCK_ITEM
  INVENTORY_ASSET
  ENTRY_LOG
  GOODS_MOVEMENT_LOG
}

model ValidationRequest {
  id           String                 @id @default(uuid())
  resourceType ValidationResourceType
  resourceId   String

  status         ValidationStatus  @default(PENDING_VALIDATION)
  previousStatus ValidationStatus?

  submittedById String
  submittedBy   User     @relation("ValidationSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  reviewedById String?
  reviewedBy   User?     @relation("ValidationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  comment String?

  createdAt DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([status])
  @@index([status, submittedAt])
}

// ─── Administration : Notifications ──────────────────────────────────────────

enum NotificationType {
  VALIDATION_SUBMITTED
  VALIDATION_APPROVED
  VALIDATION_REJECTED
  VALIDATION_CHANGES_REQUESTED
  CONTRACT_EXPIRING_SOON
  CONTRACT_EXPIRED
  PROCEDURE_EXPIRING_SOON
  PROCEDURE_EXPIRED
  PROCEDURE_RENEWAL_DUE
  PROCEDURE_RESPONSE_OVERDUE
  STOCK_LOW
  STOCK_OUT
  STOCK_EXPIRING_SOON
  STOCK_EXPIRED
  ASSET_INVENTORY_DUE
  ASSET_WARRANTY_EXPIRING_SOON
  VISITOR_OVERDUE_DEPARTURE
  VISITOR_LONG_PRESENCE
  EXPECTED_VISITOR_NO_SHOW
  GOODS_RETURN_OVERDUE
  REGISTER_INCIDENT_UNRESOLVED
}

model Notification {
  id          String @id @default(uuid())
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type         NotificationType
  resourceType ValidationResourceType?
  resourceId   String?

  title   String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([resourceType, resourceId, type])
}

// ─── Administration : Contrats fournisseurs ──────────────────────────────────

enum ContractCategory {
  BOULANGERIE
  GAZ
  EAU
  ELECTRICITE
  WOYOFAL
  ENTRETIEN
  NETTOYAGE
  SECURITE
  AUTRE
}

enum RenewalType {
  AUTOMATIQUE
  MANUEL
  NON_RENOUVELABLE
}

enum BillingFrequency {
  MENSUELLE
  TRIMESTRIELLE
  SEMESTRIELLE
  ANNUELLE
  PONCTUELLE
}

enum ContractStatus {
  BROUILLON
  ACTIF
  EXPIRE_BIENTOT
  EXPIRE
  RESILIE
  ARCHIVE
}

enum ContractValidationAction {
  CREATION
  RENEWAL
  TERMINATION
}

model SupplierContract {
  id             String           @id @default(uuid())
  supplierName   String
  contractName   String
  category       ContractCategory
  description    String?
  contractNumber String?

  startDate    DateTime
  endDate      DateTime?
  renewalDate  DateTime?
  renewalType  RenewalType?
  noticePeriod Int?

  amount           Int?
  billingFrequency BillingFrequency?

  contactPerson String?
  phone         String?
  email         String?
  address       String?

  status ContractStatus @default(ACTIF)
  notes  String?

  validationStatus        ValidationStatus?
  pendingValidationAction ContractValidationAction?

  documents  ContractDocument[]
  stockItems StockItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ContractDocument {
  id         String           @id @default(uuid())
  contractId String
  contract   SupplierContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  fileKey  String
  fileMime String
  label    String?

  createdAt DateTime @default(now())
}

// ─── Administration : Démarches administratives ──────────────────────────────

enum ProcedureType {
  AGREMENT
  DECLARATION
  AUTORISATION
  ASSURANCE
  CERTIFICAT
  DOCUMENT_JURIDIQUE
  RENOUVELLEMENT
  CONVENTION
  ATTESTATION
  AUTRE
}

enum ProcedureStatus {
  A_PREPARER
  EN_COURS
  SOUMIS
  EN_ATTENTE_REPONSE
  APPROUVE
  REFUSE
  EXPIRE
  ARCHIVE
}

enum ProcedurePriority {
  BASSE
  NORMALE
  HAUTE
  CRITIQUE
}

// Tracks which sensitive action a pending validation request corresponds to,
// mirroring ContractValidationAction on SupplierContract.
enum ProcedureValidationAction {
  SUBMISSION
  FINALIZATION
  RENEWAL
  ARCHIVE
}

enum ProcedureDocumentType {
  FORMULAIRE
  COURRIER
  RECEPISSE
  AGREMENT
  AUTORISATION
  ATTESTATION
  ASSURANCE
  CERTIFICAT
  PIECE_JURIDIQUE
  REPONSE_ADMINISTRATION
  AUTRE
}

model AdministrativeProcedure {
  id              String        @id @default(uuid())
  title           String
  procedureType   ProcedureType
  authority       String
  description     String?
  referenceNumber String?

  submissionDate       DateTime?
  expectedResponseDate DateTime?
  expirationDate       DateTime?
  renewalDate          DateTime?

  status     ProcedureStatus   @default(A_PREPARER)
  priority   ProcedurePriority @default(NORMALE)
  assignedTo String?
  notes      String?

  validationStatus        ValidationStatus?
  pendingValidationAction ProcedureValidationAction?

  createdById String?
  createdBy   User?   @relation("ProcedureCreatedBy", fields: [createdById], references: [id])

  archivedAt DateTime?

  documents ProcedureDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ProcedureDocument {
  id          String                  @id @default(uuid())
  procedureId String
  procedure   AdministrativeProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  fileKey      String
  fileMime     String
  label        String?
  documentType ProcedureDocumentType?

  uploadedById String?
  uploadedBy   User?   @relation("ProcedureDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// ─── Administration : Stocks et inventaire ───────────────────────────────────

enum StockCategory {
  ALIMENTAIRE
  HYGIENE
  ENTRETIEN
  MEDICAL
  BUREAU
  FOURNITURES_SCOLAIRES
  VETEMENTS
  LITERIE
  MOBILIER
  EQUIPEMENT
  INFORMATIQUE
  OUTILLAGE
  DON
  AUTRE
}

enum StockUnit {
  UNITE
  CARTON
  PAQUET
  KILOGRAMME
  GRAMME
  LITRE
  MILLILITRE
  BOITE
  SAC
  BOUTEILLE
  ROULEAU
  LOT
  AUTRE
}

enum StockMovementType {
  ENTREE
  SORTIE
  AJUSTEMENT_POSITIF
  AJUSTEMENT_NEGATIF
  TRANSFERT
  PERTE
  CASSE
  PEREMPTION
  DON_RECU
  DON_DISTRIBUE
  RETOUR
  INVENTAIRE_CORRECTION
}

// Tracks which sensitive stock operation a pending validation request
// corresponds to, mirroring ProcedureValidationAction / ContractValidationAction.
// Unlike those, the operation carries a numeric payload (quantity, reason, ...)
// that must survive until approval, hence pendingValidationPayload on StockItem.
enum StockValidationAction {
  LARGE_STOCK_EXIT
  NEGATIVE_ADJUSTMENT
  STOCK_LOSS
  INVENTORY_CORRECTION
  STOCK_ITEM_ARCHIVE
}

enum AssetCondition {
  NEUF
  BON
  MOYEN
  MAUVAIS
  HORS_SERVICE
}

enum AssetStatus {
  DISPONIBLE
  AFFECTE
  EN_MAINTENANCE
  PERDU
  VOLE
  CASSE
  REFORME
  ARCHIVE
}

enum AssetValidationAction {
  ASSET_TRANSFER
  ASSET_DISPOSAL
  ASSET_ARCHIVE
}

// Shared by StockItemDocument and InventoryAssetDocument — one document
// taxonomy is enough for both, avoids a duplicated enum.
enum StockDocumentType {
  FACTURE
  BON_LIVRAISON
  BON_SORTIE
  DON
  INVENTAIRE
  TRANSFERT
  REFORME
  PERTE
  VOL
  GARANTIE
  PHOTO
  AUTRE
}

model StockItem {
  id          String        @id @default(uuid())
  name        String
  reference   String?       @unique
  barcode     String?       @unique
  category    StockCategory
  description String?
  unit        StockUnit     @default(UNITE)

  currentQuantity Float  @default(0)
  minimumQuantity Float?
  maximumQuantity Float?
  reorderQuantity Float?

  unitCost Int?

  storageLocation String?
  spaceId         String?
  space           Space?  @relation(fields: [spaceId], references: [id])

  supplierName       String?
  supplierContractId String?
  supplierContract   SupplierContract? @relation(fields: [supplierContractId], references: [id])

  batchNumber    String?
  expirationDate DateTime?
  isPerishable   Boolean   @default(false)

  isActive Boolean @default(true)
  notes    String?

  validationStatus         ValidationStatus?
  pendingValidationAction  StockValidationAction?
  pendingValidationPayload Json?

  createdById String?
  createdBy   User?   @relation("StockItemCreatedBy", fields: [createdById], references: [id])

  archivedAt DateTime?

  movements      StockMovement[]
  documents      StockItemDocument[]
  goodsMovements GoodsMovementLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model StockMovement {
  id          String    @id @default(uuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  type     StockMovementType
  quantity Float

  quantityBefore Float
  quantityAfter  Float

  unitCost   Int?
  totalValue Int?

  source      String?
  destination String?
  reason      String?

  referenceDocument String?
  batchNumber       String?
  expirationDate    DateTime?

  performedById String?
  performedBy   User?   @relation("StockMovementPerformedBy", fields: [performedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("StockMovementApprovedBy", fields: [approvedById], references: [id])

  movementDate DateTime @default(now())

  validationStatus ValidationStatus?

  createdAt DateTime @default(now())

  @@index([stockItemId])
}

model StockItemDocument {
  id          String    @id @default(uuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  fileKey      String
  fileMime     String
  label        String?
  documentType StockDocumentType?

  uploadedById String?
  uploadedBy   User?   @relation("StockItemDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

model InventoryAsset {
  id           String        @id @default(uuid())
  name         String
  assetCode    String?       @unique
  serialNumber String?       @unique
  category     StockCategory
  description  String?
  brand        String?
  model        String?

  acquisitionDate DateTime?
  acquisitionCost Int?
  fundingSource   String?
  donorName       String?
  warrantyEndDate DateTime?

  condition AssetCondition @default(BON)
  status    AssetStatus    @default(DISPONIBLE)

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  assignedTo       String?
  assignedToUserId String?
  assignedToUser   User?   @relation("AssetAssignedTo", fields: [assignedToUserId], references: [id])

  lastInventoryDate DateTime?
  nextInventoryDate DateTime?

  notes String?

  validationStatus         ValidationStatus?
  pendingValidationAction  AssetValidationAction?
  pendingValidationPayload Json?

  createdById String?
  createdBy   User?   @relation("InventoryAssetCreatedBy", fields: [createdById], references: [id])

  archivedAt DateTime?

  documents      InventoryAssetDocument[]
  goodsMovements GoodsMovementLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([status])
}

model InventoryAssetDocument {
  id      String         @id @default(uuid())
  assetId String
  asset   InventoryAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  fileKey      String
  fileMime     String
  label        String?
  documentType StockDocumentType?

  uploadedById String?
  uploadedBy   User?   @relation("AssetDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// ─── Administration : Registre d'entrées/sorties ─────────────────────────────

// Who the person is. Reuses/extends the original EntryType enum members
// (VISITEUR, LIVRAISON, PRESTATAIRE, FOURNISSEUR_SERVICE→FOURNISSEUR,
// OUVRIER_MAINTENANCE→MAINTENANCE, AUTRE) rather than duplicating them under
// a new name — the original enum was semantically a visitor category, not a
// movement type.
enum VisitorCategory {
  PARENT_TUTEUR
  FOURNISSEUR
  PRESTATAIRE
  MAINTENANCE
  LIVRAISON
  PARTENAIRE
  BENEVOLE
  ADMINISTRATION
  PERSONNEL
  VISITEUR
  AUTRE
}

// What kind of movement this register row represents.
enum EntryType {
  ENTREE
  SORTIE
  VISITE_PREVUE
  VISITE_IMPREVUE
  SORTIE_TEMPORAIRE
  SORTIE_EXCEPTIONNELLE
  RETOUR
  PRESTATION
  LIVRAISON
  AUTRE
}

enum EntryStatus {
  PREVUE
  PRESENT
  SORTI
  ANNULEE
  REFUSEE
  EN_ATTENTE_VALIDATION
  ARCHIVEE
}

// Tracks which sensitive person-register operation a pending validation
// corresponds to, mirroring StockValidationAction / AssetValidationAction.
enum EntryValidationAction {
  EXCEPTIONAL_EXIT
  ACCESS_OVERRIDE
  AFTER_HOURS_ACCESS
  MANUAL_CHECKOUT_OVERRIDE
  RECORD_ARCHIVE
}

// Shared by EntryLogDocument and GoodsMovementDocument.
enum RegisterDocumentType {
  AUTORISATION_ACCES
  PIECE_IDENTITE
  BON_LIVRAISON
  BON_SORTIE
  PRET_EQUIPEMENT
  RETOUR_EQUIPEMENT
  RAPPORT_INCIDENT
  DOCUMENT_VEHICULE
  AUTRE
}

model EntryLog {
  id              String          @id @default(uuid())
  entryType       EntryType
  visitorCategory VisitorCategory

  fullName     String
  organization String?
  phone        String?
  email        String?

  identityDocumentType   String?
  identityDocumentNumber String?

  purpose       String?
  personVisited String?

  personVisitedUserId String?
  personVisitedUser   User?   @relation("EntryLogPersonVisited", fields: [personVisitedUserId], references: [id])

  spaceId String?
  space   Space?  @relation(fields: [spaceId], references: [id])

  arrivalDateTime           DateTime?
  expectedDepartureDateTime DateTime?
  actualDepartureDateTime   DateTime?

  status EntryStatus @default(PREVUE)

  accessBadgeNumber        String?
  vehicleRegistration      String?
  accompanyingPersonsCount Int     @default(0)

  authorizedBy       String?
  authorizedByUserId String?
  authorizedByUser   User?   @relation("EntryLogAuthorizedBy", fields: [authorizedByUserId], references: [id])

  recordedById String?
  recordedBy   User?   @relation("EntryLogRecordedBy", fields: [recordedById], references: [id])

  notes String?

  incidentReported    Boolean   @default(false)
  incidentId          String?
  incident            Incident? @relation(fields: [incidentId], references: [id])
  incidentDescription String?

  validationStatus         ValidationStatus?
  pendingValidationAction  EntryValidationAction?
  pendingValidationPayload Json?

  documents EntryLogDocument[]

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([spaceId])
}

model EntryLogDocument {
  id         String   @id @default(uuid())
  entryLogId String
  entryLog   EntryLog @relation(fields: [entryLogId], references: [id], onDelete: Cascade)

  fileKey      String
  fileMime     String
  label        String?
  documentType RegisterDocumentType?

  uploadedById String?
  uploadedBy   User?   @relation("EntryLogDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// ─── Administration : Registre — biens et marchandises ───────────────────────
// A deliberately separate model from EntryLog: person-identity fields
// (fullName, organization, arrival/departure) and goods fields (quantity,
// stockItemId, source/destination) don't share a coherent row shape.

enum GoodsMovementType {
  ENTREE_MARCHANDISE
  SORTIE_MARCHANDISE
  LIVRAISON
  RETOUR_FOURNISSEUR
  PRET_EQUIPEMENT
  RETOUR_EQUIPEMENT
  TRANSFERT
  SORTIE_TEMPORAIRE
  DON_RECU
  DON_DISTRIBUE
  REFORME
  AUTRE
}

enum GoodsMovementStatus {
  ENREGISTRE
  SORTI
  RETOURNE
  EN_ATTENTE_VALIDATION
  ANNULE
  ARCHIVE
}

// Tracks which sensitive goods/equipment operation a pending validation
// corresponds to.
enum GoodsValidationAction {
  HIGH_VALUE_ASSET_EXIT
  TEMPORARY_ASSET_EXIT
  CONTROLLED_GOODS_EXIT
  RECORD_ARCHIVE
}

model GoodsMovementLog {
  id            String            @id @default(uuid())
  movementType  GoodsMovementType
  description   String
  itemReference String?

  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])

  inventoryAssetId String?
  inventoryAsset   InventoryAsset? @relation(fields: [inventoryAssetId], references: [id])

  quantity Float?
  unit     StockUnit?

  source      String?
  destination String?

  personInCharge         String?
  vehicleRegistration    String?
  deliveryNoteNumber     String?
  authorizationReference String?
  reason                 String?

  movementDateTime   DateTime  @default(now())
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?

  status GoodsMovementStatus @default(ENREGISTRE)

  recordedById String?
  recordedBy   User?   @relation("GoodsMovementRecordedBy", fields: [recordedById], references: [id])

  authorizedByUserId String?
  authorizedByUser   User?   @relation("GoodsMovementAuthorizedBy", fields: [authorizedByUserId], references: [id])

  validationStatus         ValidationStatus?
  pendingValidationAction  GoodsValidationAction?
  pendingValidationPayload Json?

  incidentReported    Boolean   @default(false)
  incidentId          String?
  incident            Incident? @relation(fields: [incidentId], references: [id])
  incidentDescription String?

  notes String?

  documents GoodsMovementDocument[]

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([stockItemId])
  @@index([inventoryAssetId])
}

model GoodsMovementDocument {
  id         String           @id @default(uuid())
  movementId String
  movement   GoodsMovementLog @relation(fields: [movementId], references: [id], onDelete: Cascade)

  fileKey      String
  fileMime     String
  label        String?
  documentType RegisterDocumentType?

  uploadedById String?
  uploadedBy   User?   @relation("GoodsMovementDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}
