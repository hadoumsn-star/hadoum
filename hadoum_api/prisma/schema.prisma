//
// PR 1 scope: the directory itself only. No consuming module (SupplierContract,
// AdministrativeProcedure, MaintenanceTicket, Transaction) is given a relation
// to Contact yet — that is deliberately deferred to later PRs, one module at a
// time, per the approved implementation plan. Nothing here touches any
// existing model or field.

model ContactCategory {
  id        String  @id @default(uuid())
  key       String  @unique
  label     String
  color     String?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

