  resourceType ValidationResourceType?
  resourceId   String?

  title   String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([resourceType, resourceId, type])
}

