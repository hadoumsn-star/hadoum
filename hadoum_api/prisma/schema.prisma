// ─── Administration : Validations ────────────────────────────────────────────

enum ValidationStatus {
  DRAFT
  PENDING_VALIDATION
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ValidationResourceType {
  MAINTENANCE_TICKET
  SUPPLIER_CONTRACT
  ADMINISTRATIVE_PROCEDURE
  STOCK_ITEM
  INVENTORY_ASSET
  ENTRY_LOG
  GOODS_MOVEMENT_LOG
  ACTIVITY
  LEAVE_REQUEST
  FUND_REQUEST
  // PR 5B: an expense (DEPENSE) Transaction going through the approval
  // workflow. Named for the business meaning, like LEAVE_REQUEST wraps
  // StaffAttendance — not a bare TRANSACTION, since RECETTE transactions
  // never enter this workflow and never get a ValidationRequest.
  EXPENSE_TRANSACTION
  // PR 19 (Module 5 stabilization) — tagging only, for Notification.resourceType.
  // Neither ever goes through the ValidationRequest workflow itself (donor/
  // campaign mutations aren't validation-gated), this enum is just reused as
  // the generic "what kind of thing does this notification/resource pointer
  // refer to" tag, same as STOCK_ITEM/ENTRY_LOG above.
  CAMPAIGN
  DONOR_PROFILE
}

model ValidationRequest {
  id           String                 @id @default(uuid())
  resourceType ValidationResourceType
  resourceId   String

  status         ValidationStatus  @default(PENDING_VALIDATION)
  previousStatus ValidationStatus?

  submittedById String
  submittedBy   User     @relation("ValidationSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  reviewedById String?
  reviewedBy   User?     @relation("ValidationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  comment String?

  createdAt DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([status])
  @@index([status, submittedAt])
}

// ─── Administration : Notifications ──────────────────────────────────────────

enum NotificationType {
  VALIDATION_SUBMITTED
  VALIDATION_APPROVED
  VALIDATION_REJECTED
  VALIDATION_CHANGES_REQUESTED
  CONTRACT_EXPIRING_SOON
  CONTRACT_EXPIRED
  PROCEDURE_EXPIRING_SOON
  PROCEDURE_EXPIRED
  PROCEDURE_RENEWAL_DUE
  PROCEDURE_RESPONSE_OVERDUE
  STOCK_LOW
  STOCK_OUT
  STOCK_EXPIRING_SOON
  STOCK_EXPIRED
  ASSET_INVENTORY_DUE
  ASSET_WARRANTY_EXPIRING_SOON
  VISITOR_OVERDUE_DEPARTURE
  VISITOR_LONG_PRESENCE
  EXPECTED_VISITOR_NO_SHOW
  GOODS_RETURN_OVERDUE
  REGISTER_INCIDENT_UNRESOLVED
  // PR 5D: expense submit/approve/reject/resubmit reuse the existing
  // VALIDATION_SUBMITTED/APPROVED/REJECTED types (resourceType
  // EXPENSE_TRANSACTION disambiguates them) — only complete/cancel are new
  // concepts, since those two transitions never touch a ValidationRequest
  // (PR 5B/5C) and so have no existing VALIDATION_* type to reuse.
  EXPENSE_COMPLETED
  EXPENSE_CANCELLED
  // PR 19 (Module 5 stabilization): lazy compute-on-read alerts, same
  // pattern as CONTRACT_EXPIRING_SOON/STOCK_LOW — computed fresh on every
  // list read (CampaignsService.findAll/DonorReportsService.findAll), never
  // a cron, deduplicated per resource via the existing
  // findFirst-before-create check so a condition notifies DIRECTOR once,
  // not on every subsequent read.
  CAMPAIGN_ENDING_SOON
  CAMPAIGN_END_DATE_PASSED
  DONOR_REPORT_MISSING
}

model Notification {
  id          String @id @default(uuid())
  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

