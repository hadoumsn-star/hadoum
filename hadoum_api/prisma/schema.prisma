generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ChildStatus {
  ORPHELIN_COMPLET
  ORPHELIN_PERE
  ORPHELIN_MERE
  DEMI_ORPHELIN
  ENFANT_EN_DIFFICULTE
}

enum Gender {
  MASCULIN
  FEMININ
}

enum SchoolType {
  DAARA
  ECOLE_PUBLIQUE
  ECOLE_PRIVEE
}

enum DocumentType {
  ACTE_NAISSANCE
  ACTE_DECES
  PIECE_ID_TUTEUR
  ACCORD_AEMO
  CARNET_SANTE
  CERTIFICAT_PEC
  AUTORISATION_GOUVERNEMENTALE
  PHOTO
  ORDONNANCE
  BULLETIN_SCOLAIRE
  LEGAL_DOCUMENT
  EVALUATION_PSYCHOMOTRICE
  BILAN_PSYCHOLOGIQUE
  BILAN_SANTE
  AUTRE
}

// ─── Core entity ─────────────────────────────────────────────────────────────

model Child {
  id           String      @id @default(uuid())
  fileNumber   String      @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  placeOfBirth String
  gender       Gender
  entryDate    DateTime
  status       ChildStatus

  // Legal guardian
  guardianName     String?
  guardianPhone    String?
  guardianRelation String?

  // Emergency contacts (stored as JSON for flexibility)
  emergencyContacts Json?

  // Family situation
  familyComposition String?
  placementHistory  String?
  familyContacts    Json?

  // Exit / departure
  isActive        Boolean   @default(true)
  exitType        String? // 'temporaire' | 'définitive'
  exitDate        DateTime?
  exitReturnDate  DateTime?
  exitReason      String?
  exitResponsable String?

  // Relations
  medicalRecord     MedicalRecord?
  psychRecord       PsychRecord?
  schoolRecord      SchoolRecord?
  dailyObservations DailyObservation[]
  documents         Document[]
  eventLogs         EventLog[]
  attendanceRecords ChildAttendance[]
  incidentLinks     IncidentChild[] // PR 11

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Medical ─────────────────────────────────────────────────────────────────

model MedicalRecord {
  id      String @id @default(uuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  bloodType         String?
  allergies         String?
  currentTreatments String?
  vaccinationsText  String?
  consultationsText String?

  vaccinations  Vaccination[]
  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vaccination {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  name        String
  date        DateTime
  nextDueDate DateTime?
  notes       String?
}

model Consultation {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  date         DateTime
  doctor       String
  reason       String
  prescription String?
  documentUrl  String?

  createdAt DateTime @default(now())
}

// ─── Psychological ───────────────────────────────────────────────────────────

model PsychRecord {
  id      String @id @default(uuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  initialAssessment   String?
  pppObjectives       String?
  behavioralEvolution String?

  sessions PsychSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PsychSession {
  id            String      @id @default(uuid())
  psychRecordId String
  psychRecord   PsychRecord @relation(fields: [psychRecordId], references: [id], onDelete: Cascade)

  date         DateTime
  observations String
  progress     String?

  createdAt DateTime @default(now())
}

// ─── School ──────────────────────────────────────────────────────────────────

model SchoolRecord {
  id      String @id @default(uuid())
  childId String @unique
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  schoolType   SchoolType
  schoolName   String
  currentLevel String

  results SchoolResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolResult {
  id             String       @id @default(uuid())
  schoolRecordId String
  schoolRecord   SchoolRecord @relation(fields: [schoolRecordId], references: [id], onDelete: Cascade)

  period       String
  subject      String
  grade        Float?
  attendance   String?
  teacherNotes String?
  bulletinUrl  String?

  createdAt DateTime @default(now())
}

// ─── Daily observations ──────────────────────────────────────────────────────

model DailyObservation {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  date             DateTime
  author           String
  behavior         String
  groupIntegration String?
  incidents        String?
  notes            String?

  createdAt DateTime @default(now())
}

// ─── Documents ───────────────────────────────────────────────────────────────

model Document {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  type       DocumentType
  label      String
  fileUrl    String
  uploadedBy String?

  createdAt DateTime @default(now())
}

// ─── Event log (journal) ─────────────────────────────────────────────────────

model EventLog {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  eventType String
  summary   String
  details   String?
  author    String?

  createdAt DateTime @default(now())
}

// ─── Staff ───────────────────────────────────────────────────────────────────

enum StaffStatus {
  PRESENT
  ABSENT
  CONGE
}

// PR 10 — daily presence confirmation status. NON_CONFIRMED is deliberately
// not a value here: it's the default represented by no
// StaffPresenceConfirmation row existing for a given (staffId, date) — see
// the model's own comment.
enum StaffPresenceStatus {
  PRESENT
  ABSENT
}

enum CandidateStatus {
  NOUVEAU
  PRESELECTIONNE
  ENTRETIEN_FAIT
}

model StaffMember {
  id           String      @id @default(uuid())
  firstName    String
  lastName     String
  role         String
  classes      String[]
  status       StaffStatus @default(PRESENT)
  phone        String?
  email        String?
  since        DateTime    @default(now())
  cvKey        String?
  scheduleKey  String?
  scheduleJson String?
  notes        String?

  activities            Activity[]
  presenceConfirmations StaffPresenceConfirmation[]
  incidentLinks         IncidentStaff[] // PR 11

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Candidate {
  id                       String          @id @default(uuid())
  firstName                String
  lastName                 String
  targetRole               String?
  phone                    String?
  status                   CandidateStatus @default(NOUVEAU)
  cvKey                    String?
  typeCandidature          String?
  disponibleDe             DateTime?
  contactInfo              String?
  notes                    String?
  scheduledIntegrationDate DateTime?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FormerStaffMember {
  id                         String    @id @default(uuid())
  firstName                  String
  lastName                   String
  role                       String
  exitDate                   DateTime
  exitReason                 String
  scheduledReintegrationDate DateTime?
  scheduledRole              String?

  createdAt DateTime @default(now())
}

model CandidateDoc {
  id          String   @id @default(uuid())
  candidateId String
  key         String
  label       String
  createdAt   DateTime @default(now())
}

model StaffDoc {
  id        String   @id @default(uuid())
  staffId   String
  key       String
  label     String
  createdAt DateTime @default(now())
}

model StaffAttendance {
  id        String    @id @default(uuid())
  staffId   String
  type      String
  motif     String?
  dateDebut DateTime
  dateFin   DateTime?
  justifKey String?
  justified Boolean   @default(false)

  // null = pre-approved (created via the direct admin POST /staff/:id/attendance
  // endpoint); set when created via POST /staff/:id/leave-requests instead.
  validationStatus ValidationStatus?

  createdAt DateTime @default(now())

  @@index([validationStatus])
}

// ─── Activities (pedagogical activities pending director validation) ─────────

model Activity {
  id         String      @id @default(uuid())
  title      String
  type       String
  className  String
  educatorId String
  educator   StaffMember @relation(fields: [educatorId], references: [id], onDelete: Restrict)
  date       DateTime

  validationStatus ValidationStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validationStatus])
  @@index([educatorId])
}

// ─── Fund requests (director asks for funds, supervisor approves) ────────────

model FundRequest {
  id            String   @id @default(uuid())
  amountXof     Int
  motif         String
  requestedById String
  requestedBy   User     @relation("FundRequestRequestedBy", fields: [requestedById], references: [id])
  date          DateTime @default(now())

  validationStatus ValidationStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([validationStatus])
}

// ─── Daily attendance (children + staff presence-confirmation) ───────────────

model ChildAttendance {
  id           String   @id @default(uuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date         DateTime
  present      Boolean
  recordedById String
  recordedBy   User     @relation("ChildAttendanceRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([childId, date])
  @@index([date])
}

// PR 10 — daily presence confirmation, distinct from StaffAttendance
// (Congé/Retard/Absence leave records above). A row only ever exists once a
// DIRECTOR has explicitly confirmed PRESENT or ABSENT for that staff/date;
// "non confirmée" is never stored — it's simply the absence of a row for a
// given (staffId, date), which is what makes "reset to non-confirmed" a
// plain delete rather than a third stored state. `status` is nullable only
// to keep this migration additive (no default needed on the ALTER); the
// application always sets it on every row it ever creates. `confirmed`
// (legacy, unused before this PR) is kept populated as a derived mirror of
// `status === PRESENT` for backward compatibility — nothing reads it.
model StaffPresenceConfirmation {
  id            String               @id @default(uuid())
  staffId       String
  staffMember   StaffMember          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date          DateTime
  confirmed     Boolean
  status        StaffPresenceStatus?
  confirmedById String
  confirmedBy   User                 @relation("StaffPresenceConfirmedBy", fields: [confirmedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([date])
}

// ─── Reports ─────────────────────────────────────────────────────────────────

model Report {
  id         String   @id @default(uuid())
  title      String
  type       String
  fileKey    String
  mimeType   String
  reportDate DateTime
  uploadedBy String?

  createdAt DateTime @default(now())
}

// ─── Finances ─────────────────────────────────────────────────────────────────

enum TransactionType {
  DEPENSE
  RECETTE
}

enum TransactionCategory {
  ALIMENTATION
  SALAIRES
  ENTRETIEN
  SANTE
  PEDAGOGIE
  EQUIPEMENT
  DON
  VIREMENT
  APPORT
  AUTRE
  // PR 6 — the default monthly budget category set needed four concepts
  // this enum had no room for (clothing, transport, sport, leisure, office/
  // bills); ETUDES is kept distinct from the existing PEDAGOGIE (school
  // costs vs. pedagogical activities are different budget lines even though
  // the words are close). All four are also valid DEPENSE categories, not
  // budget-only labels — a budget with nothing that can ever be tagged
  // against it could never show real reserved/consumed amounts.
  VETEMENTS
  TRANSPORT
  ETUDES
  SPORT
  LOISIRS
  BUREAU_FACTURES
}

enum TransactionStatus {
  VALIDE
  EN_ATTENTE
}

// PR 4: stable, product-defined set — not intended to be user-configurable,
// so an enum matches every other Finance/status field in this schema
// (TransactionType, TransactionCategory, TransactionStatus) rather than a
// free-text column.
//
// MOBILE_MONEY is kept (not renamed/removed) purely for historical rows —
// Postgres enum values can't be safely dropped in place, and removing it
// would also break any existing Transaction still carrying it. New
// transactions choose WAVE_MOBILE_MONEY or ORANGE_MOBILE_MONEY instead; the
// frontend's "new transaction" dropdown is what actually enforces that
// (MOBILE_MONEY stays selectable when editing an existing transaction that
// already has it).
enum PaymentMethod {
  ESPECES
  VIREMENT
  CHEQUE
  MOBILE_MONEY
  WAVE_MOBILE_MONEY
  ORANGE_MOBILE_MONEY
  CARTE
  AUTRE
}

model Transaction {
  id        String              @id @default(uuid())
  type      TransactionType
  category  TransactionCategory
  label     String
  amountXof Int
  date      DateTime
  status    TransactionStatus   @default(EN_ATTENTE)

  justifKey  String?
  justifMime String?

  donorName        String?
  isAnonymousDonor Boolean?

  // PR 4 (Contact directory + expense documents). Additive and optional
  // throughout — see FinancesService for why paymentMethod stays optional
  // for both DEPENSE and RECETTE in this transitional PR, and why
  // supplierContactId is only ever set for DEPENSE. onDelete: SetNull for
  // the same reason as MaintenanceTicket.assignedContact (PR 3): a
  // financial record must stay valid even if the referenced Contact is
  // ever hard-deleted administratively.
  supplierContactId String?
  supplierContact   Contact?       @relation(fields: [supplierContactId], references: [id], onDelete: SetNull)
  paymentMethod     PaymentMethod?

  // Dedicated expense documents, additive alongside the legacy
  // justifKey/justifMime pair above (never removed). Each pair mirrors the
  // Contact.photoKey/photoMime convention exactly.
  purchaseOrderKey  String?
  purchaseOrderMime String?
  invoiceKey        String?
  invoiceMime       String?
  deliveryNoteKey   String?
  deliveryNoteMime  String?

  createdBy String?

  // PR 5A (Expense Approval Workflow foundation). Nullable and additive —
  // does NOT replace `status` above, which keeps its exact current meaning
  // for RECETTE and for every transaction outside this workflow. NULL means
  // "not part of the workflow" (every pre-PR-5A row, and every RECETTE
  // forever) — such rows are untouched by transition logic and stay fully
  // usable through the existing create/update/delete endpoints. See
  // ExpenseWorkflowService for the state machine this field is driven by.
  expenseWorkflowStatus ExpenseWorkflowStatus?

  // PR 14 (Module 5 foundation): reverse side of Donation.transactionId
  // (@unique there) — a Transaction backs at most one Donation. Nothing
  // writes this relation yet; PR 16 is the first to create a Transaction
  // from a Donation, through the existing FinancesService, never a second
  // ledger. Purely a schema-level relation — adds no column to this table.
  donation Donation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierContactId])
  @@index([expenseWorkflowStatus])
}

// PR 5A: intentionally does not include PURCHASE_IN_PROGRESS — the approved
// business workflow has no intermediate purchase state (see the PR 5
// design). Kept separate from TransactionStatus (VALIDE/EN_ATTENTE), which
// is a different concept (does this count as realized cash movement) that
// this PR does not touch.
enum ExpenseWorkflowStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model BudgetLine {
  id        String              @id @default(uuid())
  category  TransactionCategory
  month     Int
  year      Int
  budgetXof Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, month, year])
}

// ─── Incidents ────────────────────────────────────────────────────────────────

enum IncidentType {
  MEDICAL
  COMPORTEMENT
  SCOLAIRE
  LOGISTIQUE
  AUTRE
  // PR 11 — this enum doubles as the incident "category" in the product
  // language; kept as IncidentType rather than renamed to avoid touching the
  // existing column/consumers for a label-only distinction.
  SECURITE
}

// PR 11 replaces the incident workflow with EN_COURS / EN_ATTENTE / RESOLU.
// PLANIFIE and EN_RETARD are kept in the enum ONLY so historical rows created
// before this PR keep loading correctly (removing a Postgres enum value in
// place is not a safe operation) — the application layer (DTOs + frontend)
// rejects them for new incidents and status changes; see
// IncidentsService/CreateIncidentDto/ChangeIncidentStatusDto.
enum IncidentStatus {
  EN_COURS
  PLANIFIE // legacy — no longer selectable, preserved for historical incidents
  EN_RETARD // legacy — no longer selectable, preserved for historical incidents
  RESOLU
  EN_ATTENTE
}

// PR 11 — SLA-style triage priority, independent of status/category.
enum IncidentPriority {
  N1 // à traiter aujourd'hui
  N2 // à traiter sous 3 jours
  N3 // suivi normal
}

model Incident {
  id          String         @id @default(uuid())
  title       String
  type        IncidentType
  description String?
  signaledBy  String
  date        DateTime       @default(now())
  status      IncidentStatus @default(EN_COURS)

  // PR 11 — defaults new/legacy rows to the lowest urgency rather than
  // leaving priority nullable, so every incident (old or new) always has one
  // to display and filter on.
  priority IncidentPriority @default(N3)

  // PR 11 — nullable: incidents created before this PR have no recorded
  // creator. Distinct from `signaledBy` (free-text "reported by", unchanged)
  // — this is the authenticated user who filled the form, used to drive the
  // SUPERVISOR edit restriction and the "created by SUPERVISOR" highlight.
  createdById String?
  createdBy   User?   @relation("IncidentCreatedBy", fields: [createdById], references: [id])

  attachmentKey  String?
  attachmentMime String?

  notes          IncidentNote[]
  statusHistory  IncidentStatusHistory[]
  children       IncidentChild[]
  staffLinks     IncidentStaff[]
  spaces         IncidentSpace[]
  entryLogs      EntryLog[]
  goodsMovements GoodsMovementLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([type])
}

// Legacy free-form note log, kept only so any pre-PR-11 notes stay readable.
// PR 11 no longer writes to this model — status changes now carry their
// mandatory note through IncidentStatusHistory instead.
model IncidentNote {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  text   String
  author String

  createdAt DateTime @default(now())
}

// PR 11 — timestamped status-change history. A row only exists for an actual
// transition (create doesn't produce one — there is no previous status yet).
model IncidentStatusHistory {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  previousStatus IncidentStatus
  newStatus      IncidentStatus
  note           String

  userId String
  user   User   @relation("IncidentStatusChangedBy", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([incidentId])
}

// PR 11 — "persons concerned": links to real Child/StaffMember records
// instead of free text. Explicit join models (rather than an implicit
// Prisma m-n) so each link can be indexed and queried directly for the
// child/staff filters.
model IncidentChild {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([incidentId, childId])
  @@index([childId])
}

model IncidentStaff {
  id          String      @id @default(uuid())
  incidentId  String
  incident    Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  staffId     String
  staffMember StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([incidentId, staffId])
  @@index([staffId])
}

// "Spaces concerned" — same pattern as IncidentChild/IncidentStaff above:
// links to real Space records (the existing "Locaux et espaces" module),
// never free text, with its own index for the location filter.
model IncidentSpace {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([incidentId, spaceId])
  @@index([spaceId])
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

enum UserRole {
  DIRECTOR
  EDUCATOR
  SUPERVISOR
  BOARD
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  initials     String
  role         UserRole
  roleLabel    String
  title        String

  resetToken       String?
  resetTokenExpiry DateTime?

  validationRequestsSubmitted ValidationRequest[] @relation("ValidationSubmittedBy")
  validationRequestsReviewed  ValidationRequest[] @relation("ValidationReviewedBy")
  notifications               Notification[]

  administrativeProceduresCreated AdministrativeProcedure[] @relation("ProcedureCreatedBy")
  procedureDocumentsUploaded      ProcedureDocument[]       @relation("ProcedureDocumentUploadedBy")

  stockItemsCreated          StockItem[]              @relation("StockItemCreatedBy")
  stockMovementsPerformed    StockMovement[]          @relation("StockMovementPerformedBy")
  stockMovementsApproved     StockMovement[]          @relation("StockMovementApprovedBy")
  stockItemDocumentsUploaded StockItemDocument[]      @relation("StockItemDocumentUploadedBy")
  inventoryAssetsCreated     InventoryAsset[]         @relation("InventoryAssetCreatedBy")
  inventoryAssetsAssigned    InventoryAsset[]         @relation("AssetAssignedTo")
  assetDocumentsUploaded     InventoryAssetDocument[] @relation("AssetDocumentUploadedBy")

  entryLogsRecorded              EntryLog[]              @relation("EntryLogRecordedBy")
  entryLogsAuthorized            EntryLog[]              @relation("EntryLogAuthorizedBy")
  entryLogsVisited               EntryLog[]              @relation("EntryLogPersonVisited")
  entryLogDocumentsUploaded      EntryLogDocument[]      @relation("EntryLogDocumentUploadedBy")
  goodsMovementsRecorded         GoodsMovementLog[]      @relation("GoodsMovementRecordedBy")
  goodsMovementsAuthorized       GoodsMovementLog[]      @relation("GoodsMovementAuthorizedBy")
  goodsMovementDocumentsUploaded GoodsMovementDocument[] @relation("GoodsMovementDocumentUploadedBy")

  fundRequestsRequested   FundRequest[]               @relation("FundRequestRequestedBy")
  childAttendanceRecorded ChildAttendance[]           @relation("ChildAttendanceRecordedBy")
  staffPresenceConfirmed  StaffPresenceConfirmation[] @relation("StaffPresenceConfirmedBy")

  incidentsCreated      Incident[]              @relation("IncidentCreatedBy") // PR 11
  incidentStatusChanges IncidentStatusHistory[] @relation("IncidentStatusChangedBy") // PR 11

  auditLogs AuditLog[] @relation("AuditLogUser") // PR 13

  // PR 14 (Module 5 foundation) — all nullable createdBy-style relations,
  // same convention as every other "who created this row" FK above. No
  // business logic reads these yet; only the schema/relations exist.
  donorProfilesCreated       DonorProfile[]        @relation("DonorProfileCreatedBy")
  campaignsCreated           FundraisingCampaign[] @relation("CampaignCreatedBy")
  campaignDocumentsUploaded  CampaignDocument[]    @relation("CampaignDocumentUploadedBy")
  donationsCreated           Donation[]            @relation("DonationCreatedBy")
  donorCommunicationsCreated DonorCommunication[]  @relation("DonorCommunicationCreatedBy")
  donorReportsCreated        DonorReport[]         @relation("DonorReportCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Administration : Locaux et espaces ──────────────────────────────────────

enum SpaceType {
  SALLE_CLASSE
  DORTOIR
  CUISINE
  SANITAIRE
  BUREAU
  INFIRMERIE
  STOCKAGE
  ESPACE_EXTERIEUR
  AUTRE
}

enum SpaceCondition {
  BON
  MOYEN
  MAUVAIS
  HORS_SERVICE
}

model Space {
  id           String         @id @default(uuid())
  name         String
  type         SpaceType
  description  String?
  building     String?
  floor        String?
  zone         String?
  condition    SpaceCondition @default(BON)
  capacity     Int?
  equipment    String[]
  observations String?
  isActive     Boolean        @default(true)

  documents          SpaceDocument[]
  maintenanceTickets MaintenanceTicket[]
  stockItems         StockItem[]
  inventoryAssets    InventoryAsset[]
  entryLogs          EntryLog[]
  incidentLinks      IncidentSpace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpaceDocument {
  id      String @id @default(uuid())
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  fileKey  String
  fileMime String
  label    String?

  createdAt DateTime @default(now())
}

// ─── Administration : Tickets de maintenance ─────────────────────────────────

enum TicketUrgency {
  FAIBLE
  MOYENNE
  ELEVEE
  CRITIQUE
}

enum TicketStatus {
  OUVERT
  ASSIGNE
  EN_COURS
  EN_ATTENTE
  RESOLU
  FERME
  ANNULE
}

model MaintenanceTicket {
  id          String  @id @default(uuid())
  title       String
  description String?
  problemType String?

  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  urgency TicketUrgency
  status  TicketStatus  @default(OUVERT)

  reportedDate DateTime @default(now())
  reportedBy   String
  assignedTo   String?

  // PR 3 (Contact directory integration): nullable so existing/legacy tickets
  // keep working unchanged. `assignedTo` is kept as-is — see the service for
  // the dual-write rule (assignedContactId is the source of truth for the
  // relation, assignedTo becomes a derived display snapshot once a real
  // Contact is selected). onDelete: SetNull, not Restrict — a ticket must
  // stay valid even if its referenced contact is ever hard-deleted
  // administratively (Contact itself only supports soft deactivation today,
  // which doesn't touch this FK at all).
  assignedContactId String?
  assignedContact   Contact? @relation(fields: [assignedContactId], references: [id], onDelete: SetNull)

  plannedDate     DateTime?
  resolvedDate    DateTime?
  resolutionNotes String?

  estimatedCost Int?
  actualCost    Int?

  validationStatus ValidationStatus?

  attachments TicketAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([status])
  @@index([assignedContactId])
}

