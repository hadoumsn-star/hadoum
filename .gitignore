# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local
.env.dev
.env.development
.env.prod
.pgportable
# Portable MinIO server (PR 19) — local/test S3-compatible storage for
# running the real UploadService against real E2E/Playwright coverage
# without Docker. Same rationale as .pgportable above: a downloaded binary
# + its data dir, never committed. See hadoum_api/README.md.
.minio-portable

# Local/dev/prod database dumps
backups/

# Excel workbooks (e.g. one-off data-import source files such as
# hadoum_api/src/contacts/Fiche de contact BESOIN.xlsx) — real contact/data
# exports never belong in git; the import scripts that consume them take a
# --file path and are run manually against a local copy.
*.xlsx
*.xls

# Ad hoc schema/migration diff scratch output
audit/

# Deploy/monitor-host state (written by scripts/deploy/deploy.sh and
# scripts/monitor/check-containers.sh on the server, never meaningful in a
# local checkout)
.last_good_tag.*
.monitor_state.*

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude local config
.claude/settings.local.json

# Prisma
hadoum_api/prisma/dev.db
