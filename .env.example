# PostgreSQL
POSTGRES_USER=hadoum_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=hadoum_db

# JWT
JWT_SECRET=change_me_random_secret_min_32_chars

# Hetzner Object Storage (S3)
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=eu-central
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=hadoum

# SMTP
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Divers
FRONTEND_URL=https://hadoum.com
NGINX_SERVER_NAME=hadoum.com www.hadoum.com
NGINX_CERT_DOMAIN=hadoum.com
APP_ENV=production
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL_MS=60000
API_IMAGE=hadoum-api
FRONTEND_IMAGE=hadoum-frontend
IMAGE_TAG=latest

# Alerting (optionnel) - webhook Slack/Discord-compatible
ALERT_WEBHOOK_URL=
