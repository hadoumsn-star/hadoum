# Environnement de DEVELOPPEMENT uniquement (docker-compose.dev.yml).
# Ce fichier ne contient AUCUNE vraie valeur. Copiez-le en .env.dev puis
# remplacez les placeholders. .env.dev ne doit jamais etre commite.
#
# Ces valeurs sont volontairement DIFFERENTES de la production
# (utilisateur/base dedies a la dev) pour qu'il soit impossible de
# pointer par erreur vers la base de production depuis cet environnement.

# --- PostgreSQL (dev) ---
POSTGRES_USER=hadoum_dev_user
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=hadoum_dev_db

# URL utilisee PAR LE CONTENEUR API (reseau interne Compose, host = "postgres").
# Pour lancer Prisma depuis votre machine hote (hors conteneur), voir
# docs/DEVELOPMENT_ENVIRONMENT.md - ne remplacez pas "postgres" par "localhost" ici.
DATABASE_URL=postgresql://hadoum_dev_user:change_me_dev_password@postgres:5432/hadoum_dev_db

# --- JWT ---
JWT_SECRET=change_me_dev_jwt_secret_min_32_chars

# --- Stockage S3 (Hetzner Object Storage) - optionnel en dev ---
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=eu-central
S3_ACCESS_KEY=your_dev_access_key
S3_SECRET_KEY=your_dev_secret_key
S3_BUCKET=hadoum-dev

# --- SMTP - optionnel en dev ---
SMTP_USER=your_dev_smtp_user
SMTP_PASS=your_dev_smtp_password

# --- Divers ---
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api
PORT=3001
