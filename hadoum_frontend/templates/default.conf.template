# Rendered to /etc/nginx/conf.d/default.conf at container startup via the
# official nginx:alpine envsubst entrypoint. Only variables matching
# NGINX_ENVSUBST_FILTER (set to ^NGINX_ in the Dockerfile) are substituted,
# so nginx's own runtime variables ($host, $remote_addr, $uri, ...) are left
# untouched.
#
# Required env vars (see docker-compose.prod.yml / docker-compose.development.yml):
#   NGINX_SERVER_NAME   e.g. hadoum.com www.hadoum.com
#   NGINX_CERT_DOMAIN   Let's Encrypt live/ subdirectory, e.g. hadoum.com

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    client_max_body_size 50M;

    # Let's Encrypt HTTP-01 challenge passthrough, so certbot renewals work
    # without taking the site down.
    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    # Plain-HTTP container healthcheck target (Docker HEALTHCHECK, compose
    # healthcheck). Kept on port 80 so it never depends on TLS being
    # provisioned yet.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain always;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    client_max_body_size 50M;

    ssl_certificate /etc/letsencrypt/live/${NGINX_CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_CERT_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               image/svg+xml font/woff2;

    # Security headers - applied to every response from this server block.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # SPA fallback. index.html must never be cached (it references
    # content-hashed asset filenames, so caching it would pin old bundles).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # Content-hashed static assets: safe to cache for a long time.
    location ~* \.(?:js|css|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|eot|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain always;
    }

    location /api {
        # Resolve "api" via Docker's embedded DNS at request time (not once
        # at nginx startup) using a variable in proxy_pass, so this
        # container doesn't crash-loop if it starts before the api
        # container is resolvable, and picks up IP changes across restarts.
        resolver 127.0.0.11 valid=10s;
        set $api_upstream http://api:3001;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
